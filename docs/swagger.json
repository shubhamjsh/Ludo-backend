    "definitions": {
        "game.CreateGameRequest": {
            "type": "object",
            "required": [
                "max_players",
                "room_name"
            ],
            "properties": {
                "bet_amount": {
                    "type": "integer",
                    "minimum": 0
                },
                "is_private": {
                    "type": "boolean"
                },
                "max_players": {
                    "type": "integer",
                    "maximum": 4,
                    "minimum": 2
                },
                "room_code": {
                    "type": "string"
                },
                "room_name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 3
                }
            }
        },
        "game.CreateGameResponse": {
            "type": "object",
            "properties": {
                "created_by": {
                    "type": "integer"
                },
                "game_id": {
                    "type": "string"
                },
                "room_code": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "game.CreateLocalGameRequest": {
            "type": "object",
            "required": [
                "player_names",
                "room_name"
            ],
            "properties": {
                "player_names": {
                    "type": "array",
                    "maxItems": 4,
                    "minItems": 2,
                    "items": {
                        "type": "string"
                    }
                },
                "room_name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 3
                }
            }
        },
        "game.CreateLocalGameResponse": {
            "type": "object",
            "properties": {
                "game_id": {
                    "type": "string"
                },
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/game.LocalPlayerInfo"
                    }
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "game.JoinGameRequest": {
            "type": "object",
            "required": [
                "game_id"
            ],
            "properties": {
                "game_id": {
                    "type": "string"
                },
                "room_code": {
                    "type": "string"
                }
            }
        },
        "game.JoinGameResponse": {
            "type": "object",
            "properties": {
                "current_players": {
                    "type": "integer"
                },
                "game_id": {
                    "type": "string"
                },
                "max_players": {
                    "type": "integer"
                },
                "player_color": {
                    "type": "string"
                },
                "position": {
                    "type": "integer"
                }
            }
        },
        "game.LeaveGameResponse": {
            "type": "object",
            "properties": {
                "game_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "game.LocalPlayerInfo": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
        "game.MoveTokenRequest": {
            "type": "object",
            "required": [
                "steps",
                "token_index"
            ],
            "properties": {
                "steps": {
                    "type": "integer",
                    "maximum": 6,
                    "minimum": 1
                },
                "token_index": {
                    "type": "integer",
                    "maximum": 3,
                    "minimum": 0
                }
            }
        },
        "game.MoveTokenResponse": {
            "type": "object",
            "properties": {
                "coins_lost_per_player": {
                    "type": "integer"

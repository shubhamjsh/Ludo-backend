{
  "dashboard": {
    "title": "Ludo API Metrics",
    "panels": [
      {
        "id": 1,
        "title": "Total Requests per Endpoint",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(ludo_http_requests_total[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Request Duration (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(ludo_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Status Codes Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(ludo_http_requests_total) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Active Games",
        "type": "stat",
        "targets": [
          {
            "expr": "ludo_active_games_total"
          }
        ],
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 8}
      },
      {
        "id": 5,
        "title": "Total Dice Rolls",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(ludo_dice_rolls_total[5m])) by (value)",
            "legendFormat": "Dice {{value}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "API Errors",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(ludo_api_errors_total[5m])) by (endpoint, error_type)",
            "legendFormat": "{{endpoint}} - {{error_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      }
    ],
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}